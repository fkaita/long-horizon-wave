DESCRIPTION >
    One row per Long Horizon search: query, structured wave conditions, raw Nimble + forecast payloads.

SCHEMA >
    `timestamp` DateTime64(3) `json:$.timestamp`,
    `search_id` String `json:$.search_id`,
    `query` String `json:$.query`,
    `location` String `json:$.location`,
    `country` String `json:$.country`,
    `latitude` Float64 `json:$.latitude`,
    `longitude` Float64 `json:$.longitude`,
    `wave_height_ft` Nullable(Float32) `json:$.wave_height_ft`,
    `swell_period_sec` Nullable(Float32) `json:$.swell_period_sec`,
    `swell_direction` Nullable(String) `json:$.swell_direction`,
    `wind_mph` Nullable(Float32) `json:$.wind_mph`,
    `weather` Nullable(String) `json:$.weather`,
    `confidence` String `json:$.confidence`,
    `structured` String `json:$.structured`,
    `raw_nimble` String `json:$.raw_nimble`,
    `raw_forecast` String `json:$.raw_forecast`

ENGINE "MergeTree"
ENGINE_SORTING_KEY "timestamp"
