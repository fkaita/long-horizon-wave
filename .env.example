NIMBLE_API_KEY=
BFL_API_KEY=
# Tinybird workspace admin token (needs DATASOURCES:CREATE/APPEND + read). Host depends on your region,
# e.g. https://api.tinybird.co, https://api.us-east.tinybird.co, https://api.europe-west2.gcp.tinybird.co
TINYBIRD_TOKEN=
TINYBIRD_HOST=https://api.tinybird.co

# Optional
BFL_IMAGE_MODEL=flux-2-pro
BFL_VIDEO_MODEL=flux-3-video
BFL_VIDEO_SECONDS=5
BFL_VIDEO_DRAFT=false
ENABLE_VIDEO=true
